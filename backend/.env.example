# 서버 설정
PORT=5000
NODE_ENV=development

# MongoDB 연결 (나중에 MongoDB Atlas에서 받을 정보)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smart-budget?retryWrites=true&w=majority

# JWT 비밀키 (랜덤 문자열로 변경 필요)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# CORS 설정
CORS_ORIGIN=http://localhost:5173